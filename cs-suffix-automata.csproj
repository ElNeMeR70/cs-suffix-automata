<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>cs-suffix-automata</AssemblyName>
    <RootNamespace>suffix_automata</RootNamespace>
    <Description>Suffix automaton for O(n) substring counting</Description>
    <Authors>Mahmoud ElNemer</Authors>
    <PackageProjectUrl>https://github.com/ElNeMeR70/cs-suffix-automata</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ElNeMeR70/cs-suffix-automata</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
